# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL_PATIENT=http://localhost:3000
CLIENT_URL_DOCTOR=http://localhost:4000

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/neuro_harmony?schema=public"

# Redis Configuration (OTP & Live queues)
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your_jwt_access_token_secret_minimum_32_characters"
JWT_REFRESH_SECRET="your_jwt_refresh_token_secret_minimum_32_characters"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Razorpay Integration (Test Mode)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# File Storage Configuration
# Options: local | s3
STORAGE_PROVIDER=local
UPLOAD_DIR="./uploads"

# Amazon S3 Credentials (For future S3 migration)
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_NAME="neuro-harmony-telehealth-reports"

# Email Notifications (Nodemailer dummy SMTP)
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="no-reply@neuroharmony.in"

# SMS/WhatsApp Notifications (MSG91 Stub)
MSG91_API_KEY="your_msg91_api_key"
MSG91_SENDER_ID="NEUROH"
